namespace Fermion.Characterization {
    open Std.Intrinsic;
    open Std.Math;
    open Std.Convert;
    open Std.Arrays;
    open Fermion.Core;

    // Single-qubit Clifford element application by index (0 to 23)
    // The single-qubit Clifford group C_1 consists of 24 elements
    // Generated by combinations of H and S
    operation ApplyCliffordElement(index : Int, target : Qubit) : Unit is Adj + Ctl {
        let idx = (index % 24 + 24) % 24;

        // Pauli subgroup (indices 0 to 3)
        if (idx == 0) { } // Identity
        elif (idx == 1) { X(target); }
        elif (idx == 2) { Y(target); }
        elif (idx == 3) { Z(target); }

        // Hadamards (indices 4 to 7)
        elif (idx == 4) { H(target); }
        elif (idx == 5) { H(target); X(target); }
        elif (idx == 6) { H(target); Y(target); }
        elif (idx == 7) { H(target); Z(target); }

        // Phase rotations S (indices 8 to 11)
        elif (idx == 8) { S(target); }
        elif (idx == 9) { S(target); X(target); }
        elif (idx == 10) { S(target); Y(target); }
        elif (idx == 11) { S(target); Z(target); }

        // Compositions H * S (indices 12 to 15)
        elif (idx == 12) { H(target); S(target); }
        elif (idx == 13) { H(target); S(target); X(target); }
        elif (idx == 14) { H(target); S(target); Y(target); }
        elif (idx == 15) { H(target); S(target); Z(target); }

        // Compositions S * H (indices 16 to 19)
        elif (idx == 16) { S(target); H(target); }
        elif (idx == 17) { S(target); H(target); X(target); }
        elif (idx == 18) { S(target); H(target); Y(target); }
        elif (idx == 19) { S(target); H(target); Z(target); }

        // Compositions H * S * H (indices 20 to 23)
        elif (idx == 20) { H(target); S(target); H(target); }
        elif (idx == 21) { H(target); S(target); H(target); X(target); }
        elif (idx == 22) { H(target); S(target); H(target); Y(target); }
        elif (idx == 23) { H(target); S(target); H(target); Z(target); }
    }

    // Runs a single Randomized Benchmarking sequence of length m:
    // 1. Applies sequence of m random Cliffords
    // 2. Applies exact inversion gate (Adjoint of sequence)
    // 3. Measures survival probability of |0>
    operation RunRandomizedBenchmarkingSequence(
        sequence : Int[],
        target : Qubit
    ) : Result {
        let m = Length(sequence);

        // Forward sequence: C_1 * C_2 * ... * C_m
        for idx in 0..m - 1 {
            ApplyCliffordElement(sequence[idx], target);
        }

        // Exact inversion operator: (C_1 ... C_m)^dagger = C_m^dagger ... C_1^dagger
        for idx in m - 1..-1..0 {
            Adjoint ApplyCliffordElement(sequence[idx], target);
        }

        let res = M(target);
        Reset(target);
        return res;
    }

    // Runs Interleaved Randomized Benchmarking to isolate the fidelity of gate U
    operation RunInterleavedRBSequence(
        sequence : Int[],
        interleavedGate : (Qubit) => Unit is Adj + Ctl,
        target : Qubit
    ) : Result {
        let m = Length(sequence);

        // Interleaved sequence: C_1 * U * C_2 * U * ... * C_m * U
        for idx in 0..m - 1 {
            ApplyCliffordElement(sequence[idx], target);
            interleavedGate(target);
        }

        // Inversion: (U^dagger C_m^dagger) ... (U^dagger C_1^dagger)
        for idx in m - 1..-1..0 {
            Adjoint interleavedGate(target);
            Adjoint ApplyCliffordElement(sequence[idx], target);
        }

        let res = M(target);
        Reset(target);
        return res;
    }
}
